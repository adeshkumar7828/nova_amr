<?xml version="1.0"?>
<package format="3">
  <name>nova_bringup</name>
  <version>0.1.0</version>
  <description>Nova AMR: LiDAR over Wi-Fi (ESP32 bridge), robot outline, RViz view, scan to the Nova server.</description>
  <maintainer email="puneet.yadav@mobilise.co.in">Puneet Yadav</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
